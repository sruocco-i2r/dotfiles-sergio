#!/usr/bin/env bash

echo "setup..."
MODE='-v'
# simulation
#MODE="$MODE -n"


# .bashrc ..bash-preexec.sh .bash_aliases
stow $MODE --dotfiles bashrc-user-mint_22-ubuntu_noble-P12RM
# TODO: fresh install https://github.com/rcaloras/bash-preexec
stow $MODE --dotfiles bash-aliases


# .gitconfig
stow $MODE --dotfiles gitconfig-sergio
stow $MODE --dotfiles gitconfig-sergio-bare
stow $MODE --dotfiles gitconfig-sergio-gmail
stow $MODE --dotfiles gitconfig-workspace
stow $MODE --dotfiles gitconfig-from-pve


# tmux
# TODO: before/after un-stowing tmux dot files, install tpm and tmux-themepack plugins
# brute-force approach for now...
if [[  ! -d "tmux/dot-tmux/plugins/tmux-themepack/" ]]; then
	git clone https://github.com/jimeh/tmux-themepack.git tmux/dot-tmux/plugins/tmux-themepack
	cp -a tmux/emass.tmuxtheme tmux/dot-tmux/plugins/tmux-themepack
fi

if [[ ! -d "tmux/dot-tmux/plugins/tpm" ]]; then
	git clone https://github.com/tmux-plugins/tpm tmux/dot-tmux/plugins/tpm
fi
stow $MODE --dotfiles tmux


# gtk-3.0 (active-window bright-yellow border CSS: ~/.config/gtk-3.0/gtk.css).
# NOTE: this package uses a literal ".config" dir and plain stow (NOT
# --dotfiles). GNU Stow 2.3.1 (shipped on this box) has a bug folding a
# --dotfiles "dot-" *directory* into an existing target like ~/.config
# ("stow_contents() called with non-directory path"). A literal .config folds
# cleanly. Revert the live file from ~/.config/gtk-3.0/gtk.css.bak-<date>.
stow $MODE gtk3


# AoB...


exit

